# Серверные переменные SI BASE. Реальные значения хранить только в Render Environment Variables.
MIXROUTER_API_KEY=replace_me
MIXROUTER_BASE_URL=https://api.mixroute.ai/v1
TELEGRAM_BOT_TOKEN=replace_me
TRIBUTE_API_KEY=replace_me

# Каждая кнопка в интерфейсе привязана к своей реальной модели MixRoute.
MIXROUTER_MODEL_QWEN=qwen3.6-flash
MIXROUTER_MODEL_DEEPSEEK=deepseek-v4-flash
MIXROUTER_MODEL_GPT=gpt-6-luna
MIXROUTER_MODEL_GEMINI=gemini-3.8-flash
MIXROUTER_MODEL_GROK=grok-4.7
MIXROUTER_MODEL_CLAUDE=claude-opus-4-8
