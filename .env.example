# Серверные переменные SI BASE. Реальные значения хранить только в Render Environment Variables.
MIXROUTER_API_KEY=replace_me
MIXROUTER_BASE_URL=https://api.mixroute.ai/v1
TELEGRAM_BOT_TOKEN=replace_me
TRIBUTE_API_KEY=replace_me

# Временный рабочий маршрут MixRoute для бесплатной группы аккаунта.
# Все пункты выбора модели направляются на реально доступный канал.
MIXROUTER_MODEL_QWEN=gemini-2.5-flash
MIXROUTER_MODEL_DEEPSEEK=gemini-2.5-flash
MIXROUTER_MODEL_GPT=gemini-2.5-flash
MIXROUTER_MODEL_GEMINI=gemini-2.5-flash
MIXROUTER_MODEL_GROK=gemini-2.5-flash
MIXROUTER_MODEL_CLAUDE=gemini-2.5-flash
